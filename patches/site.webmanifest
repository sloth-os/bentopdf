{
  "name": "BentoPDF",
  "short_name": "BentoPDF",
  "description": "Free online PDF tools - Privacy-first PDF toolkit that works 100% in your browser",
  "id": "bentopdf-pwa",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#222222",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "images/favicon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "images/favicon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "images/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Open PDF with BentoPDF",
      "icons": [
        {
          "src": "images/favicon-192x192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "maskable any"
        }
      ],
      "accept": {
        "application/pdf": [".pdf"]
      },
      "launch_type": "single-client"
    }
  ],
  "categories": [
    "productivity",
    "utilities",
    "privacy",
    "pdf",
    "security",
    "offline",
    "tools"
  ],
  "screenshots": [],
  "prefer_related_applications": false
}
